# Application
APP_DEBUG=true

# OAuth server
OAUTH_PRIVATE_KEY_PATH=/path/to/oauth.private.key
OAUTH_ENCRYPTION_KEY=your-encryption-key-base64

# OAuth grant TTL (DateInterval format: PT10M = 10 minutes, PT1H = 1 hour)
AUTH_CODE_TTL=PT10M
ACCESS_TOKEN_TTL=PT1H

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Database (PostgreSQL / Propel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oauth
DB_USER=postgres
DB_PASSWORD=

# OAuth client table name
OAUTH_CLIENT_TABLE=oauth_client

# Login (demo credentials)
LOGIN_USERNAME=user
LOGIN_PASSWORD=password
